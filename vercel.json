{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/hero-bg(-mobile)?\\.(webp|jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/budget",
      "destination": "/ambulant?utm_source=linkedin&utm_campaign=therapieabbruch",
      "permanent": false
    },
    {
      "source": "/betriebliche-vorsorge",
      "destination": "/unternehmen",
      "permanent": true
    },
    {
      "source": "/bav-bkv",
      "destination": "/unternehmen",
      "permanent": true
    },
    {
      "source": "/en/corporate-benefits",
      "destination": "/en/companies",
      "permanent": true
    },
    {
      "source": "/heilpraktiker-vorsorge",
      "destination": "/heilberufe-vorsorge",
      "permanent": true
    },
    {
      "source": "/osteopathen-vorsorge",
      "destination": "/heilberufe-vorsorge",
      "permanent": true
    },
    {
      "source": "/praxis-absicherung",
      "destination": "/heilberufe-vorsorge",
      "permanent": true
    },
    {
      "source": "/auth/confirmed",
      "destination": "/app-bestaetigt",
      "permanent": true
    },
    {
      "source": "/klinik-upgrade",
      "destination": "/stationaer",
      "permanent": true
    },
    {
      "source": "/en/hospital-upgrade",
      "destination": "/en/inpatient",
      "permanent": true
    },
    {
      "source": "/heilpraktiker-zusatzversicherung",
      "destination": "/ambulant",
      "permanent": true
    },
    {
      "source": "/Ambulante-zusatzversicherung",
      "destination": "/ambulant",
      "permanent": true
    },
    {
      "source": "/healio-zahnzusatz",
      "destination": "/zahn",
      "permanent": true
    },
    {
      "source": "/healio-dental",
      "destination": "/en/dental",
      "permanent": true
    },
    {
      "source": "/en/healio-dental",
      "destination": "/en/dental",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/content/:path*",
      "destination": "https://app.healio.de/api/v1/content/:path*"
    },
    {
      "source": "/blog/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/en/blog/:slug",
      "destination": "/index.html"
    }
  ]
}
