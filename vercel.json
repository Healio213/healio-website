{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://www.googletagmanager.com https://assets.calendly.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.calendly.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://horizons-cdn.hostinger.com https://*.calendly.com https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://app.healio.de https://*.supabase.co wss://*.supabase.co https://api.emailjs.com https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://*.calendly.com https://*.elevenlabs.io wss://*.elevenlabs.io https://*.vercel-insights.com; frame-src https://calendly.com https://www.google.com; media-src 'self' data: blob: https://*.elevenlabs.io; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/hero-bg(-mobile)?\\.(webp|jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/termin",
      "destination": "/partner?utm_source=kurzlink&utm_medium=nachricht&utm_campaign=termin",
      "permanent": false
    },
    {
      "source": "/budget",
      "destination": "/ambulant?utm_source=linkedin&utm_campaign=therapieabbruch",
      "permanent": false
    },
    {
      "source": "/betriebliche-vorsorge",
      "destination": "/unternehmen",
      "permanent": true
    },
    {
      "source": "/bav-bkv",
      "destination": "/unternehmen",
      "permanent": true
    },
    {
      "source": "/en/corporate-benefits",
      "destination": "/en/companies",
      "permanent": true
    },
    {
      "source": "/heilpraktiker-vorsorge",
      "destination": "/heilberufe-vorsorge",
      "permanent": true
    },
    {
      "source": "/osteopathen-vorsorge",
      "destination": "/heilberufe-vorsorge",
      "permanent": true
    },
    {
      "source": "/praxis-absicherung",
      "destination": "/heilberufe-vorsorge",
      "permanent": true
    },
    {
      "source": "/auth/confirmed",
      "destination": "/app-bestaetigt",
      "permanent": true
    },
    {
      "source": "/klinik-upgrade",
      "destination": "/stationaer",
      "permanent": true
    },
    {
      "source": "/en/hospital-upgrade",
      "destination": "/en/inpatient",
      "permanent": true
    },
    {
      "source": "/heilpraktiker-zusatzversicherung",
      "destination": "/ambulant",
      "permanent": true
    },
    {
      "source": "/Ambulante-zusatzversicherung",
      "destination": "/ambulant",
      "permanent": true
    },
    {
      "source": "/healio-zahnzusatz",
      "destination": "/zahn",
      "permanent": true
    },
    {
      "source": "/healio-dental",
      "destination": "/en/dental",
      "permanent": true
    },
    {
      "source": "/en/healio-dental",
      "destination": "/en/dental",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/content/:path*",
      "destination": "https://app.healio.de/api/v1/content/:path*"
    },
    {
      "source": "/blog/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/en/blog/:slug",
      "destination": "/index.html"
    }
  ]
}
