{
  "headers": [
    {
      "source": "/hero-bg(-mobile)?\\.(webp|jpg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/heilpraktiker-zusatzversicherung", "destination": "/ambulant", "permanent": true },
    { "source": "/Ambulante-zusatzversicherung", "destination": "/ambulant", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!assets|favicon|og-image|sitemap|robots).*)", "destination": "/index.html" }
  ]
}
