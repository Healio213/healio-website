# Healio Website - Beispielkonfiguration
# Keine echten Werte in diese Datei schreiben. Sie gehoert ins Repository,
# die tatsaechlichen Werte gehoeren in Vercel Project Settings bzw. .env.local.

# ---------------------------------------------------------------------------
# Meta-Funnel-Tracking (Pixel + Conversions API)
# ---------------------------------------------------------------------------
# Client-seitig sichtbar (VITE_-Praefix). Ohne diesen Wert ist der gesamte
# Meta-Pfad vollstaendig inaktiv: kein Skript, kein Ereignis, kein Cookie.
VITE_META_PIXEL_ID=

# Nur auf dem Server, NIEMALS mit VITE_-Praefix und niemals in dieser Datei
# mit echtem Wert. Diese drei Variablen setzt Frank ausschliesslich in
# Vercel Project Settings > Environment Variables:
#
#   META_PIXEL_ID            Dieselbe Pixel-/Datensatz-ID wie oben.
#   META_CAPI_ACCESS_TOKEN   Conversions-API-Token aus dem Meta Events Manager.
#   META_TEST_EVENT_CODE     Optional, nur waehrend der Testphase im
#                            Events Manager unter "Testereignisse".
#
# Fehlen META_PIXEL_ID oder META_CAPI_ACCESS_TOKEN, antwortet
# /api/meta-events mit 204 und sendet nichts an Meta.

# ---------------------------------------------------------------------------
# Google-Ads-Conversion-Messung
# ---------------------------------------------------------------------------
# Client-seitig sichtbar (VITE_-Praefix). Ohne diesen Wert ist der gesamte
# Google-Ads-Pfad vollstaendig inaktiv: kein Tag, kein Ereignis, kein Cookie,
# und die Werbe-Achse des Consent Mode bleibt auf denied.
#
# Format: AW-<Ziffern>. Die Konto-ID steht im Google-Ads-Konto 442-477-8921
# unter Tools > Conversions > Tag-Einrichtung.
VITE_GOOGLE_ADS_ID=

# Conversion-Labels aus demselben Konto, je Conversion-Aktion eines.
# Leer lassen heisst: dieses Ereignis wird nicht gesendet.
#   VITE_GOOGLE_ADS_LEAD_LABEL      Abgeschickte Anfrage (Kontaktformular,
#                                   Terminlink, "Bonus sichern").
#   VITE_GOOGLE_ADS_RECHNER_LABEL   Klick auf den Rechner-CTA auf
#                                   /ambulant und /zahn.
VITE_GOOGLE_ADS_LEAD_LABEL=
VITE_GOOGLE_ADS_RECHNER_LABEL=
